{
  "_comment": "Example configuration for creating a baseline from live sites (BEFORE migration)",
  "mode": "baseline",
  "baselineDir": "./baselines",
  "domains": [
    {
      "domain": "example.com",
      "enabled": true
    },
    {
      "domain": "example2.com",
      "enabled": true
    },
    {
      "domain": "example3.com",
      "enabled": false
    }
  ],
  "validation": {
    "htmlStructure": true,
    "textContent": true,
    "images": true,
    "links": true
  },
  "screenshot": {
    "enabled": true,
    "threshold": 0.1,
    "fullPage": true
  },
  "output": {
    "directory": "./output",
    "htmlReport": true,
    "jsonReport": true,
    "screenshotArtifacts": true
  },
  "crawler": {
    "maxPages": 50,
    "timeout": 30000,
    "waitForNetworkIdle": true
  },
  "parallel": 3
}
